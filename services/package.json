{
  "name": "saloon-microservices",
  "version": "1.0.0",
  "description": "Microservices for Saloon app",
  "scripts": {
    "start:gateway": "node api-gateway/src/server.js",
    "start:auth": "node auth-service/src/server.js",
    "start:salon": "node salon-service/src/server.js",
    "start:booking": "node booking-service/src/server.js",
    "start:location": "node location-service/src/server.js",
    "start:notification": "node notification-service/src/server.js",
    "start:admin": "node admin-service/src/server.js",
    "start:all": "concurrently \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:salon\" \"npm run start:booking\" \"npm run start:location\" \"npm run start:notification\" \"npm run start:admin\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
